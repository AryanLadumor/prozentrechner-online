---
import Layout from '../layouts/Layout.astro';
import MainPercentageCalc from '../components/calculators/MainPercentageCalc.astro';
import DiscountCalc from '../components/calculators/DiscountCalc.astro';
import VatCalc from '../components/calculators/VatCalc.astro';
import RuleOfThreeCalc from '../components/calculators/RuleOfThreeCalc.astro';
import PercentageDiffCalc from '../components/calculators/PercentageDiffCalc.astro';
import SalaryCalc from '../components/calculators/SalaryCalc.astro';
import FaqSection from '../components/FaqSection.astro';
import { useTranslations } from '../i18n';

const lang = 'de';
const t = useTranslations(lang);
---

<Layout
  lang="de"
  title="Prozentrechner €: Online Prozentrechner Kostenlos mit Rechenweg"
  description="Online Prozentrechner €: Prozentwert, Prozentsatz und Grundwert sofort in Euro berechnen – kostenlos, mit Rechenweg, Formeln, Rabatt, MwSt & Dreisatz."
  canonicalUrl="https://prozentrechner-online.com/"
  alternateUrls={{
    de: "https://prozentrechner-online.com/",
    en: "https://prozentrechner-online.com/en"
  }}
>
  <!-- Hero Section -->
  <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-16 px-1">
    <!-- Trust Pill -->
    <div
      class="inline-flex items-center justify-center gap-2 px-3 py-1.5 rounded-full text-[11px] xs:text-xs font-bold border mb-4 sm:mb-5 shadow-2xs text-center max-w-full"
      style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
    >
      <span class="flex h-2 w-2 relative shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>Live-Berechnungen in € • Schritt-für-Schritt Rechenweg • 100% Kostenlos</span>
    </div>

    <!-- Main Headline -->
    <h1 class="font-display font-black text-2.5xl xs:text-3.5xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.12] mb-3 sm:mb-4" style="color: var(--text-ink);">
      Online Prozentrechner € <br class="hidden sm:inline" />
      <span style="color: var(--accent);">Sofort & Präzise mit Rechenweg</span>
    </h1>

    <p class="text-xs xs:text-sm sm:text-lg leading-relaxed max-w-2xl mx-auto px-2" style="color: var(--text-muted);">
      Ihr zuverlässiger <strong>Online Prozentrechner</strong> für Euro-Beträge, Noten, Rabatte und Finanzen. Geben Sie beliebige Zahlen ein und erhalten Sie sofort präzise Ergebnisse, mathematische Formeln und nachvollziehbare Rechenwege.
    </p>

    <!-- Quick Tool Switcher Pills -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-4 sm:pt-6">
      <a href="#hauptrechner" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-card); border-color: var(--border-hairline); color: var(--text-ink);">
        <span class="w-4 h-4 rounded flex items-center justify-center font-bold text-[11px] leading-none" style="background-color: var(--accent); color: white;">%</span>
        <span>Hauptrechner</span>
      </a>
      <a href="#rabattrechner" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <span>Rabatt & Sale</span>
      </a>
      <a href="#mwst-rechner" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        <span>MwSt (19%)</span>
      </a>
      <a href="#dreisatz-rechner" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="M7 21h10"></path>
          <path d="M12 3v18"></path>
        </svg>
        <span>Dreisatz</span>
      </a>
      <a href="#prozentuale-differenz" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>% Differenz</span>
      </a>
      <a href="#gehaltsrechner" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>Gehaltserhöhung</span>
      </a>
    </div>
  </section>

  <!-- ================= 1. MAIN PERCENTAGE CALCULATOR ================= -->
  <section id="hauptrechner" class="mb-16">
    <MainPercentageCalc lang="de" />
  </section>

  <!-- Section Divider with Title -->
  <div class="relative flex py-6 items-center my-8">
    <div class="flex-grow border-t" style="border-color: var(--border-hairline);"></div>
    <span class="flex-shrink mx-4 text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full border" style="background-color: var(--bg-card); border-color: var(--border-hairline); color: var(--text-muted);">
      Spezialisierte Rechentools
    </span>
    <div class="flex-grow border-t" style="border-color: var(--border-hairline);"></div>
  </div>

  <!-- ================= 2. DISCOUNT CALCULATOR ================= -->
  <section id="rabattrechner" class="mb-12 scroll-mt-20">
    <DiscountCalc lang="de" />
  </section>

  <!-- ================= 3. VAT CALCULATOR ================= -->
  <section id="mwst-rechner" class="mb-12 scroll-mt-20">
    <VatCalc lang="de" />
  </section>

  <!-- ================= 4. RULE OF THREE (DREISATZ) ================= -->
  <section id="dreisatz-rechner" class="mb-12 scroll-mt-20">
    <RuleOfThreeCalc lang="de" />
  </section>

  <!-- ================= 5. PERCENTAGE DIFFERENCE ================= -->
  <section id="prozentuale-differenz" class="mb-12 scroll-mt-20">
    <PercentageDiffCalc lang="de" />
  </section>

  <!-- ================= 6. SALARY RAISE CALCULATOR ================= -->
  <section id="gehaltsrechner" class="mb-16 scroll-mt-20">
    <SalaryCalc lang="de" />
  </section>

  <!-- ================= 7. EDUCATIONAL GUIDE & SEO EXPLANATION ================= -->
  <section class="rounded-3xl border p-8 sm:p-12 shadow-sm transition-all" style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);">
    <div class="max-w-3xl mx-auto space-y-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2" style="background-color: var(--bg-card); color: var(--text-ink);">
          📐 Lernhilfe & Formelreferenz
        </div>
        <h2 class="font-display font-black text-2xl sm:text-3xl tracking-tight" style="color: var(--text-ink);">
          Prozentrechner Online: Kostenlos Prozent Berechnen mit Rechenweg
        </h2>
        <p class="text-sm sm:text-base mt-2 leading-relaxed" style="color: var(--text-muted);">
          Ein Prozentrechner verwandelt eine unübersichtliche Prozentaufgabe in Sekunden in ein klares Ergebnis. Unser kostenloser Prozentrechner Online berechnet Prozentwert, Prozentsatz und Grundwert in Echtzeit und zeigt zusätzlich den vollständigen Rechenweg – also jeden einzelnen Zwischenschritt. Sie geben zwei beliebige Werte ein, der dritte wird automatisch ermittelt. Ohne Anmeldung, ohne Installation und werbefrei.
        </p>
      </div>

      <!-- Was ist ein Prozentrechner -->
      <div class="space-y-3">
        <h3 class="font-display font-extrabold text-lg" style="color: var(--text-ink);">
          Was ist ein Prozentrechner und wann brauchen Sie ihn?
        </h3>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
          Das Wort <em>Prozent</em> stammt vom lateinischen <em>per centum</em>, was „pro Hundert" bedeutet. Ein Prozent ist damit nichts anderes als der Bruch 1/100 beziehungsweise die Dezimalzahl 0,01. Ein Prozentrechner übersetzt die Beziehung zwischen einem Anteil und einem Ganzen in einen Wert, den Sie unmittelbar weiterverwenden können.
        </p>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
          Sie brauchen einen Prozentrechner überall dort, wo ein Verhältnis ins Spiel kommt: beim Einkauf, wenn 30% Rabatt auf eine 80-Euro-Jacke winken. Bei der Rechnungsstellung, wenn aus einem Nettobetrag die 19% Mehrwertsteuer herausgerechnet werden müssen. In der Gehaltsverhandlung, wenn eine Erhöhung von 4,5% in Euro beziffert werden soll. Oder in der Schule, wenn eine Klassenarbeit benotet wird. Statt Formelsammlung und Taschenrechner zu zücken, tippen Sie die bekannten Zahlen ein und lesen das Ergebnis ab.
        </p>
      </div>

      <!-- Rechenweg -->
      <div class="space-y-3">
        <h3 class="font-display font-extrabold text-lg" style="color: var(--text-ink);">
          Prozentrechner mit Rechenweg: Schritt für Schritt zum Ergebnis
        </h3>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
          Viele Online-Rechner geben lediglich eine Zahl aus. Unser Prozentrechner mit Rechenweg geht einen Schritt weiter und zeigt, wie das Ergebnis zustande kommt. Das hat zwei Vorteile: Sie können das Resultat jederzeit prüfen, und Sie verstehen die Methode – was besonders beim Lernen für Klassenarbeiten und Prüfungen hilft.
        </p>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
          Der Rechenweg folgt immer demselben Muster: Zuerst werden Grundwert, Prozentwert und Prozentsatz identifiziert. Danach setzen Sie die bekannten Werte in die passende Formel ein und berechnen das Ergebnis, das Sie auf zwei Nachkommastellen runden. Ein Beispiel: Wie viel sind 15% von 250 Euro? Der Grundwert G ist 250, der Prozentsatz p ist 15. Eingesetzt in die Formel ergibt das (250 × 15) / 100 = 3.750 / 100 = 37,50 Euro.
        </p>
      </div>

      <!-- Formula Grid Cards -->
      <div class="space-y-3">
        <h3 class="font-display font-extrabold text-lg" style="color: var(--text-ink);">
          Prozentrechner Formel: Die drei Grundformeln der Prozentrechnung
        </h3>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
          Die gesamte Prozentrechnung lässt sich auf drei Formeln reduzieren. Wer sie beherrscht, benötigt für die meisten Aufgaben nicht einmal mehr einen Taschenrechner – der Prozentrechner Online ist dann nur noch die Abkürzung.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">1. Prozentwert (W)</div>
          <div class="font-mono font-bold text-sm text-emerald-600 dark:text-emerald-400">W = (G × p) / 100</div>
          <div class="text-[11px]" style="color: var(--text-muted);">Berechnet den genauen Anteil (z.B. 15% von 250€ = 37,50€).</div>
        </div>

        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">2. Prozentsatz (p)</div>
          <div class="font-mono font-bold text-sm text-purple-600 dark:text-purple-400">p = (W / G) × 100</div>
          <div class="text-[11px]" style="color: var(--text-muted);">Findet heraus, wie viel Prozent eine Zahl vom Ganzen darstellt.</div>
        </div>

        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">3. Grundwert (G)</div>
          <div class="font-mono font-bold text-sm text-amber-600 dark:text-amber-400">G = (W × 100) / p</div>
          <div class="text-[11px]" style="color: var(--text-muted);">Berechnet die ursprünglichen 100% Gesamtsumme aus einem bekannten Prozentsatz.</div>
        </div>
      </div>

      <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
        Alle drei Formeln folgen derselben Logik: Der Prozentwert ist der Teil, der Grundwert das Ganze und der Prozentsatz das Verhältnis der beiden zueinander. Sobald zwei dieser drei Größen bekannt sind, lässt sich die dritte eindeutig bestimmen. Eine ausführliche Übersicht mit Merkhilfen, Prozentdreieck und Übungsaufgaben finden Sie auf unserer Seite
        <a href="/prozentrechner-formel" class="font-semibold underline" style="color: var(--text-ink);">Prozentrechner Formel</a>.
      </p>

      <!-- Die 5 wichtigsten Fragestellungen der Prozentrechnung (Blitzrechner-inspiriert, 100% eigener didaktischer Aufbau) -->
      <div class="space-y-6 pt-2">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2" style="background-color: var(--bg-surface-soft); color: var(--accent);">
            Schritt-für-Schritt Anleitungen
          </span>
          <h3 class="font-display font-black text-xl sm:text-2xl" style="color: var(--text-ink);">
            Typische Fragestellungen der Prozentrechnung im Alltag
          </h3>
          <p class="text-sm sm:text-base leading-relaxed mt-1" style="color: var(--text-muted);">
            In der Praxis formuliert man selten abstrakte Variablen wie <em>p</em> oder <em>G</em>. Meistens steht man vor einer ganz konkreten Frage im Geschäft, beim Gehalt oder bei Rechnungen. Hier erfahren Sie, wie Sie jede der fünf typischen Kernfragen blitzschnell und fehlerfrei lösen:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Frage 1: Prozentwert berechnen -->
          <div class="p-5 rounded-2xl border space-y-3" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-xs flex items-center justify-center">1</span>
              <h4 class="font-bold text-sm sm:text-base" style="color: var(--text-ink);">
                „Wie viel sind 20 % von 350 €?“ (Prozentwert)
              </h4>
            </div>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
              <strong>Szenario:</strong> Sie sehen einen Preisnachlass oder möchten wissen, welcher Geldbetrag einem bestimmten Anteil entspricht.
            </p>
            <div class="p-3 rounded-xl border text-xs font-mono space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
              <div class="text-emerald-600 dark:text-emerald-400 font-bold">W = (350 € × 20) ÷ 100 = 70 €</div>
              <div class="text-[11px] font-sans" style="color: var(--text-muted);">Schnellweg: 10 % von 350 € sind 35 €. Verdoppeln = 70 €.</div>
            </div>
          </div>

          <!-- Frage 2: Prozentsatz ermitteln -->
          <div class="p-5 rounded-2xl border space-y-3" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-xs flex items-center justify-center">2</span>
              <h4 class="font-bold text-sm sm:text-base" style="color: var(--text-ink);">
                „Wie viel Prozent sind 45 von 60?“ (Prozentsatz)
              </h4>
            </div>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
              <strong>Szenario:</strong> In einer Schulklausur haben Sie 45 von 60 Punkten erreicht, oder von 60 geladenen Gästen haben 45 zugesagt.
            </p>
            <div class="p-3 rounded-xl border text-xs font-mono space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
              <div class="text-purple-600 dark:text-purple-400 font-bold">p = (45 ÷ 60) × 100 = 75 %</div>
              <div class="text-[11px] font-sans" style="color: var(--text-muted);">Bruchrechnung: 45/60 lässt sich mit 15 kürzen zu 3/4 = 0,75 = 75 %.</div>
            </div>
          </div>

          <!-- Frage 3: Grundwert finden -->
          <div class="p-5 rounded-2xl border space-y-3" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center justify-center">3</span>
              <h4 class="font-bold text-sm sm:text-base" style="color: var(--text-ink);">
                „60 € sind 15 % von welchem Wert?“ (Grundwert)
              </h4>
            </div>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
              <strong>Szenario:</strong> Eine Anzahlung von 60 € deckt 15 % der Gesamtkosten ab. Wie viel kostet das Produkt insgesamt?
            </p>
            <div class="p-3 rounded-xl border text-xs font-mono space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
              <div class="text-amber-600 dark:text-amber-400 font-bold">G = (60 € × 100) ÷ 15 = 400 €</div>
              <div class="text-[11px] font-sans" style="color: var(--text-muted);">Dreisatz-Logik: 15 % = 60 € &rarr; 1 % = 4 € &rarr; 100 % = 400 €.</div>
            </div>
          </div>

          <!-- Frage 4: Aufschlag und Abschlag direkt berechnen -->
          <div class="p-5 rounded-2xl border space-y-3" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 font-bold text-xs flex items-center justify-center">4</span>
              <h4 class="font-bold text-sm sm:text-base" style="color: var(--text-ink);">
                „Grundbetrag ± X %“ (Aufschlag / Rabatt direkt)
              </h4>
            </div>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
              <strong>Szenario:</strong> Berechnen Sie den Endpreis in einem einzigen Rechenschritt ohne Zwischenergebnis.
            </p>
            <div class="p-3 rounded-xl border text-xs font-mono space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
              <div><strong class="text-teal-600 dark:text-teal-400">+19% MwSt:</strong> 500 € × 1,19 = 595 € Brutto</div>
              <div><strong class="text-pink-600 dark:text-pink-400">−20% Rabatt:</strong> 500 € × 0,80 = 400 € Sparpreis</div>
            </div>
          </div>
        </div>

        <!-- Frage 5: Ausgangswert vor Aufschlag/Rabatt (Vollbreite) -->
        <div class="p-5 rounded-2xl border space-y-3" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 font-bold text-xs flex items-center justify-center">5</span>
            <h4 class="font-bold text-sm sm:text-base" style="color: var(--text-ink);">
              „Ausgangswert vor einer Veränderung finden: 238 € sind 19 % mehr als was?“
            </h4>
          </div>
          <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
            <strong>Die klassische Umkehrfalle:</strong> Wer einen Bruttopreis von 238 € hat und 19 % davon abzieht (238 € − 45,22 € = 192,78 €), rechnet falsch! Denn die 19 % bezogen sich ursprünglich auf den kleineren Nettowert, nicht auf den Endpreis.
          </p>
          <div class="p-3.5 rounded-xl border text-xs font-mono space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
            <div class="text-rose-600 dark:text-rose-400 font-bold text-sm">
              Richtiger Rechenweg: 238 € ÷ 1,19 = 200,00 € Netto
            </div>
            <div class="text-[11px] font-sans" style="color: var(--text-muted);">
