---
import Layout from '../../layouts/Layout.astro';
import PercentageDiffCalc from '../../components/calculators/PercentageDiffCalc.astro';
---

<Layout
  lang="en"
  title="Percentage Difference Calculator Online: Change & Growth"
  description="Percentage difference calculator online: find the percentage difference or percentage change between two numbers. Free, with a step-by-step solution."
  canonicalUrl="https://prozentrechner-online.com/en/percentage-difference"
  alternateUrls={{
    de: "https://prozentrechner-online.com/prozentuale-differenz",
    en: "https://prozentrechner-online.com/en/percentage-difference"
  }}
>
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-xs font-semibold mb-3" style="color: var(--text-muted);">
      <a href="/en" class="hover:underline">Home</a>
      <span>&rsaquo;</span>
      <span style="color: var(--text-ink);">Percentage Difference</span>
    </nav>

    <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-2" style="color: var(--text-ink);">
      Percentage Difference & Change Calculator
    </h1>
    <p class="text-sm sm:text-base max-w-2xl" style="color: var(--text-muted);">
      Calculate the percentage difference between two values or the percentage change (growth or decrease) from a start value to an end value.
    </p>
  </div>

  <div class="mb-16">
    <PercentageDiffCalc lang="en" />
  </div>

  <div class="rounded-3xl border p-8 sm:p-10 shadow-sm space-y-6" style="background-color: var(--bg-surface); border-color: var(--border-hairline);">
    <h2 class="font-display font-black text-2xl tracking-tight" style="color: var(--text-ink);">
      Percentage Difference vs. Percentage Change
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-sm text-purple-600 dark:text-purple-400">Percentage Change</h3>
        <div class="font-mono text-xs font-bold">
          ((New − Old) ÷ Old) × 100
        </div>
        <p class="text-[11px]" style="color: var(--text-muted);">
          <strong>Directional:</strong> From old to new value. Shows growth (+) or decrease (−). Base is the starting value.
        </p>
      </div>

      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-sm text-amber-600 dark:text-amber-400">Percentage Difference</h3>
        <div class="font-mono text-xs font-bold">
          (|A − B| ÷ ((A + B) ÷ 2)) × 100
        </div>
        <p class="text-[11px]" style="color: var(--text-muted);">
          <strong>Symmetric:</strong> Compares two values without direction. Base is the average of both values. Always positive.
        </p>
      </div>
    </div>
  </div>
</Layout>
