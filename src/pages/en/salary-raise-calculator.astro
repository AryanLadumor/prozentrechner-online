---
import Layout from '../../layouts/Layout.astro';
import SalaryCalc from '../../components/calculators/SalaryCalc.astro';
---

<Layout
  lang="en"
  title="Salary Raise Calculator: Calculate Pay Increase Percentage"
  description="Calculate your salary raise in percentage and dollar amount. Find out how much more you'll earn after a pay increase. Free salary calculator."
  canonicalUrl="https://prozentrechner-online.com/en/salary-raise-calculator"
  alternateUrls={{
    de: "https://prozentrechner-online.com/gehaltsrechner",
    en: "https://prozentrechner-online.com/en/salary-raise-calculator"
  }}
>
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-xs font-semibold mb-3" style="color: var(--text-muted);">
      <a href="/en" class="hover:underline">Home</a>
      <span>&rsaquo;</span>
      <span style="color: var(--text-ink);">Salary Calculator</span>
    </nav>

    <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-2" style="color: var(--text-ink);">
      Salary Raise Calculator: Pay Increase in $ & %
    </h1>
    <p class="text-sm sm:text-base max-w-2xl" style="color: var(--text-muted);">
      Calculate how a percentage salary raise affects your gross and net income. Ideal for salary negotiations and financial planning.
    </p>
  </div>

  <div class="mb-16">
    <SalaryCalc lang="en" />
  </div>

  <div class="rounded-3xl border p-8 sm:p-10 shadow-sm space-y-6" style="background-color: var(--bg-surface); border-color: var(--border-hairline);">
    <h2 class="font-display font-black text-2xl tracking-tight" style="color: var(--text-ink);">
      How to Calculate Salary Raises
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-sm" style="color: var(--text-ink);">Percentage → Dollar Amount</h3>
        <div class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">
          Raise = Old Salary × (Percent ÷ 100)
        </div>
        <p class="text-[11px]" style="color: var(--text-muted);">
          Example: $50,000 + 5% = $50,000 × 0.05 = <strong>$2,500</strong> more
        </p>
      </div>

      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-sm" style="color: var(--text-ink);">Dollar Amount → Percentage</h3>
        <div class="font-mono text-xs font-bold text-purple-600 dark:text-purple-400">
          Percent = (Raise ÷ Old Salary) × 100
        </div>
        <p class="text-[11px]" style="color: var(--text-muted);">
          Example: $50,000 + $2,500 = (2,500 ÷ 50,000) × 100 = <strong>5%</strong>
        </p>
      </div>
    </div>
  </div>
</Layout>
