---
import Layout from '../../layouts/Layout.astro';
import MainPercentageCalc from '../../components/calculators/MainPercentageCalc.astro';
import { useTranslations } from '../../i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  lang="en"
  title="Percentage Calculator: Free Online % Math Tool with Rechenweg"
  description="Instant percentage calculations with step-by-step Rechenweg, formulas, and visual proportion bars. Solve discounts, VAT (MwSt), Rule of Three (Dreisatz), and salary raises effortlessly."
  canonicalUrl="https://prozentrechner-online.com/en"
  alternateUrls={{
    de: "https://prozentrechner-online.com/",
    en: "https://prozentrechner-online.com/en"
  }}
>
  <!-- Hero Section -->
  <section class="text-center max-w-3xl mx-auto mb-8 sm:mb-16 px-1">
    <!-- Trust Pill -->
    <div
      class="inline-flex items-center justify-center gap-2 px-3 py-1.5 rounded-full text-[11px] xs:text-xs font-bold border mb-4 sm:mb-5 shadow-2xs text-center max-w-full"
      style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
    >
      <span class="flex h-2 w-2 relative shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>{t('hero.trustPill')}</span>
    </div>

    <!-- Main Headline -->
    <h1 class="font-display font-black text-2.5xl xs:text-3.5xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.12] mb-3 sm:mb-4" style="color: var(--text-ink);">
      {t('hero.headline')} <br class="hidden sm:inline" />
      <span style="color: var(--accent);">{t('hero.headlineAccent')}</span>
    </h1>

    <p class="text-xs xs:text-sm sm:text-lg leading-relaxed max-w-2xl mx-auto px-2" style="color: var(--text-muted);">
      {t('hero.subheadline')}
    </p>

    <!-- Quick Tool Switcher Pills -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-4 sm:pt-6">
      <a href="/en#main-calc" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-card); border-color: var(--border-hairline); color: var(--text-ink);">
        <span class="w-4 h-4 rounded flex items-center justify-center font-bold text-[11px] leading-none" style="background-color: var(--accent); color: white;">%</span>
        <span>{t('hero.mainCalc')}</span>
      </a>
      <a href="/en/discount-calculator#discount-tool" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <span>{t('hero.discountTool')}</span>
      </a>
      <a href="/en/vat-calculator#vat-tool" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        <span>{t('hero.vatTool')}</span>
      </a>
      <a href="/en/rule-of-three-calculator#dreisatz-tool" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
          <path d="M7 21h10"></path>
          <path d="M12 3v18"></path>
        </svg>
        <span>{t('hero.dreisatzTool')}</span>
      </a>
      <a href="/en/percentage-difference#diff-tool" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>{t('hero.diffTool')}</span>
      </a>
      <a href="/en/salary-raise-calculator#salary-tool" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-bold border transition-all hover:scale-105 active:scale-95 shadow-2xs touch-target" style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);">
        <svg class="w-3.5 h-3.5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>{t('hero.salaryTool')}</span>
      </a>
    </div>
  </section>

  <!-- ================= MAIN PERCENTAGE CALCULATOR ================= -->
  <section class="mb-16">
    <MainPercentageCalc lang="en" />
  </section>

  <!-- Section Divider with Title -->
  <div class="relative flex py-6 items-center my-8">
    <div class="grow border-t" style="border-color: var(--border-hairline);"></div>
    <span class="shrink mx-4 text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full border" style="background-color: var(--bg-card); border-color: var(--border-hairline); color: var(--text-muted);">
      {t('section.specialized')}
    </span>
    <div class="grow border-t" style="border-color: var(--border-hairline);"></div>
  </div>

  <!-- Educational Guide -->
  <section class="rounded-3xl border p-8 sm:p-12 shadow-sm transition-all" style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);">
    <div class="max-w-3xl mx-auto space-y-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2" style="background-color: var(--bg-card); color: var(--text-ink);">
          {t('guide.badge')}
        </div>
        <h2 class="font-display font-black text-2xl sm:text-3xl tracking-tight" style="color: var(--text-ink);">
          {t('guide.title')}
        </h2>
        <p class="text-sm sm:text-base mt-2 leading-relaxed" style="color: var(--text-muted);" set:html={t('guide.intro')} />
      </div>

      <!-- Formula Grid Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">{t('formula.percentageValue')}</div>
          <div class="font-mono font-bold text-sm text-emerald-600 dark:text-emerald-400">W = (G × p) / 100</div>
          <div class="text-[11px]" style="color: var(--text-muted);">{t('formula.percentageValueDesc')}</div>
        </div>

        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">{t('formula.percentageRate')}</div>
          <div class="font-mono font-bold text-sm text-purple-600 dark:text-purple-400">p = (W / G) × 100</div>
          <div class="text-[11px]" style="color: var(--text-muted);">{t('formula.percentageRateDesc')}</div>
        </div>

        <div class="p-4 rounded-2xl border space-y-1.5" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
          <div class="font-bold text-xs" style="color: var(--text-ink);">{t('formula.baseValue')}</div>
          <div class="font-mono font-bold text-sm text-amber-600 dark:text-amber-400">G = (W × 100) / p</div>
          <div class="text-[11px]" style="color: var(--text-muted);">{t('formula.baseValueDesc')}</div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-4 pt-4 border-t" style="border-color: var(--border-hairline);">
        <h3 class="font-display font-extrabold text-lg" style="color: var(--text-ink);">{t('faq.title')}</h3>

        <div class="space-y-3 text-xs sm:text-sm">
          <div class="p-4 rounded-2xl border" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
            <div class="font-bold mb-1" style="color: var(--text-ink);">{t('faq.changeVsDiff.q')}</div>
            <div style="color: var(--text-muted);" set:html={t('faq.changeVsDiff.a')} />
          </div>

          <div class="p-4 rounded-2xl border" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
            <div class="font-bold mb-1" style="color: var(--text-ink);">{t('faq.vatTrap.q')}</div>
            <div style="color: var(--text-muted);" set:html={t('faq.vatTrap.a')} />
          </div>

          <div class="p-4 rounded-2xl border" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
            <div class="font-bold mb-1" style="color: var(--text-ink);">{t('faq.dreisatz.q')}</div>
            <div style="color: var(--text-muted);" set:html={t('faq.dreisatz.a')} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
