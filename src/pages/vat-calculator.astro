---
import Layout from '../layouts/Layout.astro';
import VatCalc from '../components/calculators/VatCalc.astro';
---

<Layout
  title="VAT Calculator: Net to Gross & Gross to Net (MwSt Rechner)"
  description="Free online VAT / Mehrwertsteuer calculator. Calculate Net and Gross amounts with 19% standard, 7% reduced, and custom tax rates."
  canonicalUrl="https://prozentrechner-online.com/vat-calculator"
>
  <!-- Breadcrumb & Header -->
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-xs font-semibold mb-3" style="color: var(--text-muted);">
      <a href="/" class="hover:underline">Home</a>
      <span>&rsaquo;</span>
      <span style="color: var(--text-ink);">VAT Calculator</span>
    </nav>

    <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-2" style="color: var(--text-ink);">
      Online VAT & Sales Tax Calculator (Mehrwertsteuer)
    </h1>
    <p class="text-sm sm:text-base max-w-2xl" style="color: var(--text-muted);">
      Calculate Net to Gross (adding VAT) or Gross to Net (extracting VAT) with instant accuracy and official tax rates.
    </p>
  </div>

  <!-- Interactive Tool -->
  <div class="mb-16">
    <VatCalc />
  </div>

  <!-- Educational Guide -->
  <div class="rounded-3xl border p-8 sm:p-10 shadow-sm space-y-6" style="background-color: var(--bg-surface); border-color: var(--border-hairline);">
    <h2 class="font-display font-black text-2xl tracking-tight" style="color: var(--text-ink);">
      How Value Added Tax (VAT / MwSt) is Calculated
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-teal-600 dark:text-teal-400">1. Adding VAT (Net &rarr; Gross)</h3>
        <p style="color: var(--text-muted);">Used by businesses when pricing products before tax:</p>
        <code class="block font-bold">Gross = Net &times; (1 + Rate &divide; 100)</code>
        <p style="color: var(--text-muted);">Example at 19%: <code>$100 &times; 1.19 = $119.00</code></p>
      </div>

      <div class="p-4 rounded-2xl border space-y-2" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <h3 class="font-bold text-teal-600 dark:text-teal-400">2. Extracting VAT (Gross &rarr; Net)</h3>
        <p style="color: var(--text-muted);">Used to find the pre-tax cost from an all-inclusive receipt:</p>
        <code class="block font-bold">Net = Gross &divide; (1 + Rate &divide; 100)</code>
        <p style="color: var(--text-muted);">Example at 19%: <code>$119 &divide; 1.19 = $100.00</code></p>
      </div>
    </div>
  </div>
</Layout>
