---
import ErrorLayout from '../layouts/ErrorLayout.astro';

// Astro passes the thrown error to 500.astro for on-demand rendered pages.
// It is only logged here — never rendered — so no internals leak to visitors.
interface Props {
  error?: unknown;
}
const { error } = Astro.props;
if (error) console.error('[500]', error);
---

<ErrorLayout
  lang="de"
  variant="500"
  canonicalUrl="https://prozentrechner-online.com/500"
  alternateUrls={{
    de: 'https://prozentrechner-online.com/500',
    en: 'https://prozentrechner-online.com/en/500',
  }}
/>
