---
import Layout from '../layouts/Layout.astro';
import PercentageDiffCalc from '../components/calculators/PercentageDiffCalc.astro';
---

<Layout
  title="Percentage Difference & Percentage Change Calculator"
  description="Compare two values to calculate percentage difference, relative increase/decrease, and absolute difference in real-time."
  canonicalUrl="https://prozentrechner-online.com/percentage-difference"
>
  <!-- Breadcrumb & Header -->
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-xs font-semibold mb-3" style="color: var(--text-muted);">
      <a href="/" class="hover:underline">Home</a>
      <span>&rsaquo;</span>
      <span style="color: var(--text-ink);">Percentage Difference Calculator</span>
    </nav>

    <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-2" style="color: var(--text-ink);">
      Percentage Difference & Change Calculator
    </h1>
    <p class="text-sm sm:text-base max-w-2xl" style="color: var(--text-muted);">
      Compare any two numbers to find the relative percentage change, symmetric difference, and absolute variance.
    </p>
  </div>

  <!-- Interactive Tool -->
  <div class="mb-16">
    <PercentageDiffCalc />
  </div>

  <!-- Educational Guide -->
  <div class="rounded-3xl border p-8 sm:p-10 shadow-sm space-y-6" style="background-color: var(--bg-surface); border-color: var(--border-hairline);">
    <h2 class="font-display font-black text-2xl tracking-tight" style="color: var(--text-ink);">
      Percentage Change vs. Percentage Difference
    </h2>

    <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
      Although they sound similar, they answer two different mathematical questions:
    </p>

    <div class="space-y-3 text-xs sm:text-sm">
      <div class="p-4 rounded-2xl border space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <div class="font-bold text-amber-600 dark:text-amber-400">1. Percentage Change (Directional)</div>
        <div style="color: var(--text-muted);">
          Used when there is an "old" starting value and a "new" ending value (e.g. price inflation or portfolio growth).
        </div>
        <div class="font-mono font-bold pt-1">Change% = ((New &minus; Old) &divide; Old) &times; 100</div>
      </div>

      <div class="p-4 rounded-2xl border space-y-1" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
        <div class="font-bold text-amber-600 dark:text-amber-400">2. Percentage Difference (Symmetric)</div>
        <div style="color: var(--text-muted);">
          Used when comparing two values where neither is the baseline (e.g. comparing the height of two trees or product prices at two stores).
        </div>
        <div class="font-mono font-bold pt-1">Difference% = (|V1 &minus; V2| &divide; ((V1 + V2) / 2)) &times; 100</div>
      </div>
    </div>
  </div>
</Layout>
