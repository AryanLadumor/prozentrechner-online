---
import { useTranslations } from '../i18n';

interface Props {
  targetInputId: string;
  presets?: { label: string; value: number | string }[];
  className?: string;
  lang?: 'de' | 'en';
}

const {
  targetInputId,
  presets,
  className = '',
  lang = 'de'
} = Astro.props;

const t = useTranslations(lang);

const defaultPresets = [
  { label: '5%', value: 5 },
  { label: '10%', value: 10 },
  { label: '15%', value: 15 },
  { label: t('preset.vat19'), value: 19 },
  { label: '20%', value: 20 },
  { label: '25%', value: 25 },
  { label: '50%', value: 50 },
  { label: '75%', value: 75 }
];

const chips = presets ?? defaultPresets;
---

<div class={`flex flex-wrap items-center justify-center sm:justify-start gap-1.5 sm:gap-2 ${className}`}>
  <span class="text-[11px] font-semibold opacity-60 mr-0.5 w-full xs:w-auto text-center xs:text-left" style="color: var(--text-muted);">{t('preset.quick')}</span>
  {chips.map(p => (
    <button
      type="button"
      class="preset-chip px-2.5 py-1 sm:py-1.5 rounded-xl text-xs font-semibold border transition-all hover:scale-105 active:scale-95 cursor-pointer shadow-2xs shrink-0"
      style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
      data-target={targetInputId}
      data-val={p.value}
    >
      {p.label}
    </button>
  ))}
</div>

<script>
  function initPresetChips() {
    document.querySelectorAll('.preset-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const targetId = chip.getAttribute('data-target');
        const val = chip.getAttribute('data-val');
        if (!targetId || val === null) return;

        const targetEl = document.getElementById(targetId) as HTMLInputElement | null;
        if (targetEl) {
          targetEl.value = val;
          targetEl.dispatchEvent(new Event('input', { bubbles: true }));
          targetEl.focus();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initPresetChips);
</script>
