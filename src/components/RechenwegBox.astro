---
import { useTranslations } from '../i18n';

interface Props {
  id: string;
  defaultOpen?: boolean;
  lang?: 'de' | 'en';
}

const { id, defaultOpen = false, lang = 'de' } = Astro.props;
const t = useTranslations(lang);
---

<div class="mt-3 pt-3 border-t" style="border-color: var(--border-hairline);" id={`rechenweg-container-${id}`}>
  <button
    type="button"
    class="rw-toggle-btn flex items-center justify-between w-full text-left py-2 px-1 text-xs font-bold cursor-pointer group rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors touch-target"
    style="color: var(--text-ink);"
    data-target={`rw-content-${id}`}
    aria-expanded={defaultOpen ? "true" : "false"}
  >
    <span class="flex items-center gap-2">
      <span class="w-5 h-5 rounded-lg flex items-center justify-center text-[10px] font-bold shrink-0 shadow-2xs" style="background-color: var(--bg-card); color: var(--text-ink);">
        ℹ
      </span>
      <span class="text-xs sm:text-sm font-semibold">{t('rw.toggle')}</span>
    </span>
    <svg class="rw-arrow w-4 h-4 transition-transform duration-200 opacity-60 group-hover:opacity-100 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id={`rw-content-${id}`}
    class={`rw-content mt-2 p-3 sm:p-4 rounded-2xl border space-y-3 text-xs ${defaultOpen ? '' : 'hidden'}`}
    style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);"
  >
    <!-- Visual Proportion Bar -->
    <div class="rw-proportion-container hidden space-y-1.5 pb-2 border-b" style="border-color: var(--border-hairline);">
      <div class="flex items-center justify-between text-[11px] font-semibold" style="color: var(--text-muted);">
        <span>{t('rw.proportion')}</span>
        <span class="rw-pct-label font-bold text-emerald-600 dark:text-emerald-400">0%</span>
      </div>
      <div class="w-full h-2.5 rounded-full overflow-hidden bg-black/10 dark:bg-white/10 relative">
        <div
          class="rw-proportion-bar h-full rounded-full transition-all duration-500 ease-out bg-emerald-500"
          style="width: 0%;"
        ></div>
      </div>
    </div>

    <!-- Steps list injected via JS -->
    <div class="rw-steps-list space-y-2 font-mono text-[11px]" style="color: var(--text-body);">
      <p class="opacity-60 italic font-sans text-xs">{t('calc.rechenwegEmpty')}</p>
    </div>

    <!-- Copy Rechenweg Button -->
    <div class="pt-2 flex justify-end">
      <button
        type="button"
        class="rw-copy-btn px-3 py-1.5 rounded-xl border text-xs font-semibold flex items-center gap-1.5 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer shadow-2xs touch-target"
        style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
      >
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
        </svg>
        <span>{t('rw.copySteps')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initRechenwegToggles() {
    document.querySelectorAll('.rw-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const content = document.getElementById(targetId);
        const arrow = btn.querySelector('.rw-arrow');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          content?.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (arrow) (arrow as HTMLElement).style.transform = 'rotate(0deg)';
        } else {
          content?.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (arrow) (arrow as HTMLElement).style.transform = 'rotate(180deg)';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initRechenwegToggles);
</script>
