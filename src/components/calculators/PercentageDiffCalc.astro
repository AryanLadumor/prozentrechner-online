---
---

<div class="rounded-2xl sm:rounded-3xl border p-3.5 sm:p-6 lg:p-8 shadow-sm transition-all" style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);" id="diff-calc-card">
  <!-- Header -->
  <div class="flex items-center justify-between pb-4 sm:pb-6 border-b" style="border-color: var(--border-hairline);">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl flex items-center justify-center font-bold text-lg bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400 shrink-0 shadow-2xs">
        <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
      </div>
      <div>
        <h3 class="font-display font-extrabold text-lg xs:text-xl sm:text-2xl" style="color: var(--text-ink);">
          Percentage Difference & Change
        </h3>
        <p class="text-xs sm:text-sm" style="color: var(--text-muted);">
          Compare two numbers to compute absolute difference, relative change, and average difference.
        </p>
      </div>
    </div>

    <button
      type="button"
      id="diff-reset-btn"
      class="p-2 sm:px-3 sm:py-1.5 rounded-xl border text-xs font-bold hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer flex items-center gap-1.5 touch-target"
      style="border-color: var(--border-hairline); color: var(--text-muted);"
      title="Reset difference inputs"
      aria-label="Reset difference inputs"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
      <span class="hidden sm:inline">Reset</span>
    </button>
  </div>

  <!-- Form Fields Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 sm:pt-6">
    <!-- Inputs Column -->
    <div class="space-y-4">
      <div>
        <label for="diff-v1" class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color: var(--text-ink);">
          First Value (Value 1)
        </label>
        <input
          type="text"
          id="diff-v1"
          inputmode="decimal"
          placeholder="80"
          class="w-full px-4 py-2.5 sm:py-3 rounded-xl border font-bold text-base sm:text-lg outline-none shadow-2xs"
          style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-ink);"
        />
      </div>

      <div>
        <label for="diff-v2" class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color: var(--text-ink);">
          Second Value (Value 2)
        </label>
        <input
          type="text"
          id="diff-v2"
          inputmode="decimal"
          placeholder="100"
          class="w-full px-4 py-2.5 sm:py-3 rounded-xl border font-bold text-base sm:text-lg outline-none shadow-2xs"
          style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-ink);"
        />
      </div>
    </div>

    <!-- Results Display Column -->
    <div class="flex flex-col justify-between p-4 sm:p-6 rounded-2xl border space-y-4" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
      <div class="space-y-3">
        <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--border-hairline);">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Comparison Metrics</span>
          <button
            type="button"
            id="diff-copy-btn"
            class="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-xl border font-bold hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-2xs touch-target"
            style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
            title="Copy comparison metrics"
            aria-label="Copy comparison metrics"
          >
            <svg class="w-3.5 h-3.5 opacity-75 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
            </svg>
            <span class="copy-text">Copy Metrics</span>
          </button>
        </div>

        <!-- Metric 1: Relative Change from V1 to V2 -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">Change (V1 &rarr; V2):</span>
          <span class="font-mono font-bold text-amber-600 dark:text-amber-400 text-sm sm:text-base" id="diff-res-v1-to-v2">+0.0%</span>
        </div>

        <!-- Metric 2: Reverse Change from V2 to V1 -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">Reverse Change (V2 &rarr; V1):</span>
          <span class="font-mono font-bold text-sm sm:text-base" id="diff-res-v2-to-v1" style="color: var(--text-ink);">-0.0%</span>
        </div>

        <!-- Metric 3: Difference Relative to Average -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">Difference Relative to Midpoint:</span>
          <span class="font-mono font-bold" id="diff-res-avg">0.0%</span>
        </div>

        <!-- Metric 4: Absolute Difference -->
        <div class="flex items-center justify-between pt-3 border-t text-sm font-bold" style="border-color: var(--border-hairline);">
          <span style="color: var(--text-ink);">Absolute Difference (|V1 − V2|):</span>
          <span class="font-display font-black text-2xl text-amber-600 dark:text-amber-400" id="diff-res-abs">0</span>
        </div>
      </div>

      <!-- Explanation note -->
      <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-[11px] leading-relaxed" style="color: var(--text-body);">
        <strong>Difference vs Change:</strong> Percentage change depends on which value is the baseline starting point, whereas difference compares both numbers symmetrically relative to their midpoint average.
      </div>
    </div>
  </div>
</div>

<script>
  import { calcPercentageDifference, formatNumber } from '../../utils/math';
  import { saveHistoryItem } from '../../utils/history';

  function initPercentageDiffCalc() {
    const v1Input = document.getElementById('diff-v1') as HTMLInputElement | null;
    const v2Input = document.getElementById('diff-v2') as HTMLInputElement | null;

    const resV1toV2 = document.getElementById('diff-res-v1-to-v2');
    const resV2toV1 = document.getElementById('diff-res-v2-to-v1');
    const resAvg = document.getElementById('diff-res-avg');
    const resAbs = document.getElementById('diff-res-abs');
    const copyBtn = document.getElementById('diff-copy-btn');
    const resetBtn = document.getElementById('diff-reset-btn');

    function evalDiff() {
      if (!v1Input || !v2Input || !resV1toV2 || !resV2toV1 || !resAvg || !resAbs) return;

      const res = calcPercentageDifference(v1Input.value, v2Input.value);
      if (res) {
        const sign1 = res.relativeChangeV1toV2 > 0 ? '+' : '';
        const sign2 = res.relativeChangeV2toV1 > 0 ? '+' : '';

        resV1toV2.textContent = `${sign1}${formatNumber(res.relativeChangeV1toV2, 2)}%`;
        resV2toV1.textContent = `${sign2}${formatNumber(res.relativeChangeV2toV1, 2)}%`;
        resAvg.textContent = `${formatNumber(res.averageDiffPct, 2)}%`;
        resAbs.textContent = formatNumber(res.absoluteDiff, 2);

        saveHistoryItem({
          toolType: 'difference',
          toolName: 'Percentage Difference',
          inputs: { v1: v1Input.value, v2: v2Input.value },
          result: `Diff: ${formatNumber(res.averageDiffPct, 2)}% | Change: ${sign1}${formatNumber(res.relativeChangeV1toV2, 2)}%`,
          summary: `Comparing ${v1Input.value} and ${v2Input.value}`
        });
      } else {
        resV1toV2.textContent = '—';
        resV2toV1.textContent = '—';
        resAvg.textContent = '—';
        resAbs.textContent = '0';
      }
    }

    v1Input?.addEventListener('input', evalDiff);
    v2Input?.addEventListener('input', evalDiff);

    copyBtn?.addEventListener('click', async () => {
      const summary = `Change ${v1Input?.value} → ${v2Input?.value}: ${resV1toV2?.textContent} (Absolute diff: ${resAbs?.textContent})`;
      const ok = await (window as any).copyAndToast?.(summary, 'Comparison summary copied!');
      if (ok) {
        const label = copyBtn.querySelector('.copy-text');
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = prev; }, 1500);
        }
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (v1Input) v1Input.value = '';
      if (v2Input) v2Input.value = '';
      evalDiff();
    });
  }

  document.addEventListener('DOMContentLoaded', initPercentageDiffCalc);
</script>
