---
import PresetChips from '../PresetChips.astro';
---

<div class="rounded-2xl sm:rounded-3xl border p-3.5 sm:p-6 lg:p-8 shadow-sm transition-all" style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);" id="salary-calc-card">
  <!-- Header -->
  <div class="flex items-center justify-between pb-4 sm:pb-6 border-b" style="border-color: var(--border-hairline);">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl flex items-center justify-center font-bold text-lg bg-orange-100 dark:bg-orange-950 text-orange-600 dark:text-orange-400 shrink-0 shadow-2xs">
        <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
        </svg>
      </div>
      <div>
        <h3 class="font-display font-extrabold text-lg xs:text-xl sm:text-2xl" style="color: var(--text-ink);">
          Salary & Pay Raise Calculator
        </h3>
        <p class="text-xs sm:text-sm" style="color: var(--text-muted);">
          Calculate wage increases, new hourly/monthly/annual compensation, and extra earnings.
        </p>
      </div>
    </div>

    <button
      type="button"
      id="salary-reset-btn"
      class="p-2 sm:px-3 sm:py-1.5 rounded-xl border text-xs font-bold hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer flex items-center gap-1.5 touch-target"
      style="border-color: var(--border-hairline); color: var(--text-muted);"
      title="Reset salary inputs"
      aria-label="Reset salary inputs"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
      <span class="hidden sm:inline">Reset</span>
    </button>
  </div>

  <!-- Pay Frequency Switcher -->
  <div class="pt-4 sm:pt-6">
    <div class="inline-flex rounded-2xl border p-1 w-full sm:w-auto flex-col xs:flex-row gap-1 xs:gap-0" style="background-color: var(--bg-card); border-color: var(--border-hairline);">
      <button
        type="button"
        id="salary-period-annual"
        class="salary-period-btn flex-1 sm:flex-none px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer bg-orange-600 text-white shadow-xs touch-target text-center"
        data-period="annual"
      >
        Annual Salary
      </button>
      <button
        type="button"
        id="salary-period-monthly"
        class="salary-period-btn flex-1 sm:flex-none px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white touch-target text-center"
        data-period="monthly"
      >
        Monthly Pay
      </button>
      <button
        type="button"
        id="salary-period-hourly"
        class="salary-period-btn flex-1 sm:flex-none px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white touch-target text-center"
        data-period="hourly"
      >
        Hourly Wage
      </button>
    </div>
  </div>

  <!-- Form Fields Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 sm:pt-6">
    <!-- Inputs Column -->
    <div class="space-y-4">
      <div>
        <label for="salary-base" class="block text-xs font-bold uppercase tracking-wider mb-1.5" id="salary-base-label" style="color: var(--text-ink);">
          Current Annual Salary ($ / €)
        </label>
        <input
          type="text"
          id="salary-base"
          inputmode="decimal"
          placeholder="65,000"
          class="w-full px-4 py-2.5 sm:py-3 rounded-xl border font-bold text-base sm:text-lg outline-none shadow-2xs"
          style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-ink);"
        />
      </div>

      <div>
        <label for="salary-raise-pct" class="block text-xs font-bold uppercase tracking-wider mb-1.5" style="color: var(--text-ink);">
          Percentage Raise (%)
        </label>
        <div class="relative">
          <input
            type="text"
            id="salary-raise-pct"
            inputmode="decimal"
            placeholder="5"
            class="w-full px-4 py-2.5 sm:py-3 pr-8 rounded-xl border font-bold text-base sm:text-lg outline-none shadow-2xs"
            style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-ink);"
          />
          <span class="absolute right-3.5 top-2.5 sm:top-3 font-bold text-sm pointer-events-none opacity-50">%</span>
        </div>
        <div class="mt-2.5">
          <PresetChips
            targetInputId="salary-raise-pct"
            presets={[
              { label: '3% (COLA)', value: 3 },
              { label: '5% (Standard)', value: 5 },
              { label: '8%', value: 8 },
              { label: '10% (Promotion)', value: 10 },
              { label: '15%', value: 15 },
              { label: '20%', value: 20 }
            ]}
          />
        </div>
      </div>
    </div>

    <!-- Results Display Column -->
    <div class="flex flex-col justify-between p-4 sm:p-6 rounded-2xl border space-y-4" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline);">
      <div class="space-y-3">
        <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--border-hairline);">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">New Compensation</span>
          <button
            type="button"
            id="salary-copy-btn"
            class="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-xl border font-bold hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-2xs touch-target"
            style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
            title="Copy new compensation"
            aria-label="Copy new compensation"
          >
            <svg class="w-3.5 h-3.5 opacity-75 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>

        <!-- Metric 1: New Annual -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">New Annual Salary:</span>
          <span class="font-display font-black text-2xl sm:text-3xl text-orange-600 dark:text-orange-400" id="salary-res-annual">$0</span>
        </div>

        <!-- Metric 2: New Monthly -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">New Monthly Pay:</span>
          <span class="font-mono font-bold text-sm sm:text-base" id="salary-res-monthly" style="color: var(--text-ink);">$0</span>
        </div>

        <!-- Metric 3: New Hourly -->
        <div class="flex items-center justify-between text-xs sm:text-sm">
          <span style="color: var(--text-muted);">New Hourly Rate (40h/wk):</span>
          <span class="font-mono font-bold text-sm sm:text-base" id="salary-res-hourly" style="color: var(--text-ink);">$0</span>
        </div>

        <!-- Extra earnings badge -->
        <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between text-xs font-bold">
          <span class="text-emerald-700 dark:text-emerald-300">Extra Monthly Earnings:</span>
          <span class="text-emerald-700 dark:text-emerald-300 font-mono text-sm" id="salary-res-diff">+$0 / mo</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calcSalaryRaise, formatNumber } from '../../utils/math';
  import { saveHistoryItem } from '../../utils/history';

  function initSalaryCalc() {
    let period: 'hourly' | 'monthly' | 'annual' = 'annual';
    const baseInput = document.getElementById('salary-base') as HTMLInputElement | null;
    const raiseInput = document.getElementById('salary-raise-pct') as HTMLInputElement | null;
    const baseLabel = document.getElementById('salary-base-label');

    const resAnnual = document.getElementById('salary-res-annual');
    const resMonthly = document.getElementById('salary-res-monthly');
    const resHourly = document.getElementById('salary-res-hourly');
    const resDiff = document.getElementById('salary-res-diff');
    const copyBtn = document.getElementById('salary-copy-btn');
    const resetBtn = document.getElementById('salary-reset-btn');

    const btnAnnual = document.getElementById('salary-period-annual');
    const btnMonthly = document.getElementById('salary-period-monthly');
    const btnHourly = document.getElementById('salary-period-hourly');

    function evalSalary() {
      if (!baseInput || !raiseInput || !resAnnual || !resMonthly || !resHourly || !resDiff) return;

      const res = calcSalaryRaise(baseInput.value, period, raiseInput.value);
      if (res) {
        resAnnual.textContent = `$${formatNumber(res.newAnnual, 2)}`;
        resMonthly.textContent = `$${formatNumber(res.newMonthly, 2)}`;
        resHourly.textContent = `$${formatNumber(res.newHourly, 2)}`;
        resDiff.textContent = `+$${formatNumber(res.differenceMonthly, 2)} / mo`;

        saveHistoryItem({
          toolType: 'salary',
          toolName: 'Salary Raise Calculator',
          inputs: { base: baseInput.value, raise: raiseInput.value, period },
          result: `New: $${formatNumber(res.newAnnual, 2)}/yr (+$${formatNumber(res.differenceMonthly, 2)}/mo)`,
          summary: `$${baseInput.value} (${period}) + ${raiseInput.value}% raise`
        });
      } else {
        resAnnual.textContent = '$0.00';
        resMonthly.textContent = '$0.00';
        resHourly.textContent = '$0.00';
        resDiff.textContent = '+$0.00 / mo';
      }
    }

    btnAnnual?.addEventListener('click', () => {
      period = 'annual';
      updatePeriodButtons();
      if (baseLabel) baseLabel.textContent = 'Current Annual Salary ($ / €)';
      evalSalary();
    });

    btnMonthly?.addEventListener('click', () => {
      period = 'monthly';
      updatePeriodButtons();
      if (baseLabel) baseLabel.textContent = 'Current Monthly Pay ($ / €)';
      evalSalary();
    });

    btnHourly?.addEventListener('click', () => {
      period = 'hourly';
      updatePeriodButtons();
      if (baseLabel) baseLabel.textContent = 'Current Hourly Wage ($ / hr)';
      evalSalary();
    });

    function updatePeriodButtons() {
      [btnAnnual, btnMonthly, btnHourly].forEach(btn => {
        if (!btn) return;
        const p = btn.getAttribute('data-period');
        if (p === period) {
          btn.className = 'salary-period-btn flex-1 sm:flex-none px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer bg-orange-600 text-white shadow-xs touch-target';
        } else {
          btn.className = 'salary-period-btn flex-1 sm:flex-none px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white touch-target';
        }
      });
    }

    baseInput?.addEventListener('input', evalSalary);
    raiseInput?.addEventListener('input', evalSalary);

    copyBtn?.addEventListener('click', async () => {
      const summary = `New Salary: ${resAnnual?.textContent}/yr (${resMonthly?.textContent}/mo, ${resHourly?.textContent}/hr)`;
      const ok = await (window as any).copyAndToast?.(summary, 'Salary calculation copied!');
      if (ok) {
        const label = copyBtn.querySelector('.copy-text');
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = prev; }, 1500);
        }
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (baseInput) baseInput.value = '';
      if (raiseInput) raiseInput.value = '';
      evalSalary();
    });
  }

  document.addEventListener('DOMContentLoaded', initSalaryCalc);
</script>
