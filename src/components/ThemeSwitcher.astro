---
// Theme Switcher Component supporting 4 distinctive, refined themes
import { useTranslations, getLangFromUrl } from '../i18n';

interface Props {
  lang?: 'de' | 'en';
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url) || 'de';
const t = useTranslations(currentLang);
---

<div class="relative inline-block text-left" id="theme-menu-container">
  <button
    type="button"
    id="theme-menu-button"
    class="w-8.5 h-8.5 sm:w-auto sm:h-auto flex items-center justify-center gap-1.5 sm:gap-2 px-0 sm:px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all cursor-pointer shadow-xs touch-target"
    style="background-color: var(--bg-surface); color: var(--text-ink); border-color: var(--border-hairline);"
    aria-expanded="false"
    aria-haspopup="true"
    title={t('theme.title')}
  >
    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block shrink-0" id="current-theme-dot"></span>
    <span id="current-theme-name" class="hidden md:inline">{t('theme.label')}</span>
    <svg class="w-3.5 h-3.5 opacity-60 hidden sm:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Theme Dropdown Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-2 w-48 sm:w-52 max-w-[calc(100vw-24px)] rounded-2xl p-2 shadow-2xl border z-50 transition-all origin-top-right backdrop-blur-md"
    style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);"
    role="menu"
  >
    <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider opacity-60" style="color: var(--text-muted);">
      {t('theme.heading')}
    </div>

    <button
      type="button"
      class="theme-option w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-colors text-left cursor-pointer"
      data-theme-val="clay"
      role="menuitem"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-3.5 h-3.5 rounded-full border border-amber-300 shrink-0" style="background-color: #fffaf0;"></span>
        <span>{t('theme.clay')}</span>
      </div>
      <span class="theme-check hidden font-bold text-emerald-600 dark:text-emerald-400">✓</span>
    </button>

    <button
      type="button"
      class="theme-option w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-colors text-left cursor-pointer"
      data-theme-val="dark"
      role="menuitem"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-3.5 h-3.5 rounded-full border border-cyan-700 shrink-0" style="background-color: #090a0f;"></span>
        <span>{t('theme.dark')}</span>
      </div>
      <span class="theme-check hidden font-bold text-emerald-600 dark:text-emerald-400">✓</span>
    </button>

    <button
      type="button"
      class="theme-option w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-colors text-left cursor-pointer"
      data-theme-val="white"
      role="menuitem"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-3.5 h-3.5 rounded-full border border-slate-300 shrink-0" style="background-color: #ffffff;"></span>
        <span>{t('theme.white')}</span>
      </div>
      <span class="theme-check hidden font-bold text-emerald-600 dark:text-emerald-400">✓</span>
    </button>

    <button
      type="button"
      class="theme-option w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-colors text-left cursor-pointer"
      data-theme-val="nordic"
      role="menuitem"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-3.5 h-3.5 rounded-full border border-sky-400 shrink-0" style="background-color: #f1f5f9;"></span>
        <span>{t('theme.nordic')}</span>
      </div>
      <span class="theme-check hidden font-bold text-emerald-600 dark:text-emerald-400">✓</span>
    </button>
  </div>

  <script
    type="application/json"
    id="theme-i18n"
    set:html={JSON.stringify({
      clay: t('theme.clayShort'),
      dark: t('theme.darkShort'),
      white: t('theme.white'),
      nordic: t('theme.nordic'),
    })}
  />
</div>

<script>
  function initThemeSwitcher() {
    const btn = document.getElementById('theme-menu-button');
    const menu = document.getElementById('theme-dropdown');
    const nameSpan = document.getElementById('current-theme-name');
    const dotSpan = document.getElementById('current-theme-dot');
    const options = document.querySelectorAll('.theme-option');

    // Translations injected at build time
    const themeI18nEl = document.getElementById('theme-i18n');
    const TL = themeI18nEl?.textContent
      ? JSON.parse(themeI18nEl.textContent)
      : { clay: 'Clay Cream', dark: 'Midnight', white: 'Pure White', nordic: 'Nordic Slate' };

    const themeMeta: Record<string, { label: string; color: string }> = {
      clay: { label: TL.clay, color: '#e8b94a' },
      dark: { label: TL.dark, color: '#38bdf8' },
      white: { label: TL.white, color: '#0f172a' },
      nordic: { label: TL.nordic, color: '#0284c7' }
    };

    function updateActiveThemeUI(theme: string) {
      const meta = themeMeta[theme] || themeMeta.clay;
      if (nameSpan) nameSpan.textContent = meta.label;
      if (dotSpan) dotSpan.style.backgroundColor = meta.color;

      options.forEach(opt => {
        const val = opt.getAttribute('data-theme-val');
        const check = opt.querySelector('.theme-check');
        if (val === theme) {
          opt.classList.add('font-bold');
          opt.style.backgroundColor = 'var(--bg-card)';
          opt.style.color = 'var(--text-ink)';
          check?.classList.remove('hidden');
        } else {
          opt.classList.remove('font-bold');
          opt.style.backgroundColor = 'transparent';
          opt.style.color = 'var(--text-body)';
          check?.classList.add('hidden');
        }
      });
    }

    let currentTheme = document.documentElement.getAttribute('data-theme') || 'clay';
    if (currentTheme === 'colorful') {
      currentTheme = 'clay';
      document.documentElement.setAttribute('data-theme', 'clay');
      localStorage.setItem('pct_theme', 'clay');
    }
    updateActiveThemeUI(currentTheme);

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
        menu?.classList.add('hidden');
      }
    });

    options.forEach(opt => {
      opt.addEventListener('click', () => {
        const theme = opt.getAttribute('data-theme-val') || 'clay';
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('pct_theme', theme);
        updateActiveThemeUI(theme);
        menu?.classList.add('hidden');
        window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme } }));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initThemeSwitcher);
</script>
