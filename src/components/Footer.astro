---
// Footer Component following DESIGN.md warm cream guidelines
---

<footer class="border-t mt-20 pt-16 pb-12 transition-colors" style="background-color: var(--bg-surface-soft); border-color: var(--border-hairline); color: var(--text-body);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b" style="border-color: var(--border-hairline);">
      <!-- Column 1: Brand & Description -->
      <div class="md:col-span-1 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center font-black text-sm" style="background-color: var(--brand-primary); color: var(--brand-primary-text);">
            %
          </div>
          <span class="font-display font-bold text-base" style="color: var(--text-ink);">Percentage Calculator</span>
        </div>
        <p class="text-xs leading-relaxed" style="color: var(--text-muted);">
          The fastest, most comprehensive online percentage calculation platform with interactive step-by-step solutions (Rechenweg) and instant precision.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold" style="background-color: var(--bg-card); color: var(--text-ink); border: 1px solid var(--border-hairline);">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100% Free & Ad-Free UX
          </span>
        </div>
      </div>

      <!-- Column 2: Core Calculators -->
      <div>
        <h3 class="font-display font-bold text-xs uppercase tracking-wider mb-3.5" style="color: var(--text-ink);">
          Percentage Tools
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/#percentage_quotation" class="hover:underline opacity-80 hover:opacity-100">What is X% of Y? (Percentage Value)</a></li>
          <li><a href="/#percentage_rate" class="hover:underline opacity-80 hover:opacity-100">X is what % of Y? (Percentage Rate)</a></li>
          <li><a href="/#base_value" class="hover:underline opacity-80 hover:opacity-100">X is Y% of what? (Base Value)</a></li>
          <li><a href="/#percentage_change" class="hover:underline opacity-80 hover:opacity-100">Percentage Change & Growth</a></li>
          <li><a href="/#final_value" class="hover:underline opacity-80 hover:opacity-100">Add or Subtract % (Markup / Markdown)</a></li>
        </ul>
      </div>

      <!-- Column 3: Specialized Calculators -->
      <div>
        <h3 class="font-display font-bold text-xs uppercase tracking-wider mb-3.5" style="color: var(--text-ink);">
          Specialized Calculators
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/discount-calculator" class="hover:underline opacity-80 hover:opacity-100">Discount & Sale Calculator</a></li>
          <li><a href="/vat-calculator" class="hover:underline opacity-80 hover:opacity-100">VAT / MwSt Calculator</a></li>
          <li><a href="/rule-of-three-calculator" class="hover:underline opacity-80 hover:opacity-100">Rule of Three (Dreisatz)</a></li>
          <li><a href="/percentage-difference" class="hover:underline opacity-80 hover:opacity-100">Percentage Difference</a></li>
          <li><a href="/salary-raise-calculator" class="hover:underline opacity-80 hover:opacity-100">Salary & Pay Raise Calculator</a></li>
        </ul>
      </div>

      <!-- Column 4: Guides & Educational -->
      <div>
        <h3 class="font-display font-bold text-xs uppercase tracking-wider mb-3.5" style="color: var(--text-ink);">
          Formulas & Learning
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/percentage-formula" class="hover:underline opacity-80 hover:opacity-100">Mathematical Formulas</a></li>
          <li><a href="/percentage-formula#rechenweg-guide" class="hover:underline opacity-80 hover:opacity-100">Rechenweg & Calculation Steps</a></li>
          <li><a href="/percentage-formula#vat-trap" class="hover:underline opacity-80 hover:opacity-100">The VAT Calculation Trap (+/- 19%)</a></li>
          <li><a href="/percentage-formula#cheat-sheet" class="hover:underline opacity-80 hover:opacity-100">Printable Math Cheat Sheet</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs" style="color: var(--text-muted);">
      <div>
        &copy; {new Date().getFullYear()} prozentrechner-online.com &middot; All rights reserved.
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span>⚡ Built with Astro & Tailwind CSS</span>
        <span>&middot;</span>
        <span>🌍 Multi-locale ready (EN / DE)</span>
      </div>
    </div>
  </div>
</footer>
