---
import Layout from './Layout.astro';
import { getLocalizedPath } from '../i18n/routes';

type Variant = '404' | '500';

interface Props {
  lang: 'de' | 'en';
  variant: Variant;
  canonicalUrl: string;
  alternateUrls: { de: string; en: string };
}

const { lang, variant, canonicalUrl, alternateUrls } = Astro.props;

const copyByLang = {
  de: {
    '404': {
      badge: 'Fehler 404',
      heading: 'Seite nicht gefunden',
      text: 'Die gewünschte Seite existiert nicht oder wurde verschoben. Kein Problem – hier geht es direkt weiter.',
      meterLabel: 'Trefferquote',
      meterValue: '0 %',
      primaryCta: 'Zum Prozentrechner',
      secondaryCta: 'Rechner suchen',
      secondaryAction: 'search',
      linksTitle: 'Beliebte Rechner',
      hint: 'Tipp: Prüfen Sie die Adresse auf Tippfehler oder öffnen Sie die Suche mit Strg + K.',
    },
    '500': {
      badge: 'Fehler 500',
      heading: 'Da ist etwas schiefgelaufen',
      text: 'Ein unerwarteter Serverfehler ist aufgetreten. Bitte versuchen Sie es in wenigen Augenblicken erneut – unsere Rechner sind weiterhin verfügbar.',
      meterLabel: 'Status',
      meterValue: 'Fehler',
      primaryCta: 'Zur Startseite',
      secondaryCta: 'Erneut versuchen',
      secondaryAction: 'reload',
      linksTitle: 'Weiterrechnen',
      hint: 'Alle Berechnungen laufen lokal in Ihrem Browser – bereits eingegebene Werte gehen dabei nicht verloren.',
    },
  },
  en: {
    '404': {
      badge: 'Error 404',
      heading: 'Page not found',
      text: "That page doesn't exist or has been moved. No problem — the calculators you were probably looking for are right here.",
      meterLabel: 'Match rate',
      meterValue: '0%',
      primaryCta: 'Go to calculator',
      secondaryCta: 'Search tools',
      secondaryAction: 'search',
      linksTitle: 'Popular calculators',
      hint: 'Tip: check the URL for typos, or press Ctrl + K to search.',
    },
    '500': {
      badge: 'Error 500',
      heading: 'Something went wrong',
      text: 'An unexpected server error occurred. Please try again in a moment — our calculators are still available below.',
      meterLabel: 'Status',
      meterValue: 'Error',
      primaryCta: 'Go to homepage',
      secondaryCta: 'Try again',
      secondaryAction: 'reload',
      linksTitle: 'Keep calculating',
      hint: 'Every calculation runs locally in your browser — values you already entered are not affected.',
    },
  },
} as const;

const copy = copyByLang[lang][variant];

const homeRoute = getLocalizedPath('/', lang);

const toolLinks = [
  { path: '/discount-calculator', de: 'Rabattrechner', en: 'Discount Calculator' },
  { path: '/vat-calculator', de: 'MwSt-Rechner', en: 'VAT Calculator' },
  { path: '/rule-of-three-calculator', de: 'Dreisatz-Rechner', en: 'Rule of Three' },
  { path: '/percentage-difference', de: 'Prozentuale Differenz', en: 'Percentage Difference' },
  { path: '/salary-raise-calculator', de: 'Gehaltsrechner', en: 'Salary Raise Calculator' },
  { path: '/percentage-formula', de: 'Formeln & Lernen', en: 'Formulas & Guide' },
].map((link) => ({
  href: getLocalizedPath(link.path, lang),
  label: link[lang],
}));

const isNotFound = variant === '404';
---

<Layout
  lang={lang}
  title={`${copy.badge} – ${copy.heading}`}
  description={copy.text}
  canonicalUrl={canonicalUrl}
  alternateUrls={alternateUrls}
  robots="noindex, follow"
>
  <div class="max-w-3xl mx-auto">
    <!-- Hero card -->
    <section
      class="relative overflow-hidden rounded-3xl border text-center px-6 py-12 sm:px-12 sm:py-16"
      style="background-color: var(--bg-surface); border-color: var(--border-hairline); box-shadow: var(--card-shadow);"
    >
      <!-- Decorations -->
      <div
        class="pointer-events-none absolute -top-16 -right-12 w-48 h-48 rounded-full opacity-10"
        style="background-color: var(--accent);"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-16 w-56 h-56 rounded-full opacity-10"
        style="background-color: var(--brand-lavender);"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <!-- Badge -->
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-[11px] font-bold uppercase tracking-wider mb-6"
          style="background-color: var(--badge-bg); border-color: var(--border-hairline); color: var(--badge-text);"
        >
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--accent);"></span>
          {copy.badge}
        </span>

        <!-- Big status code: the middle 0 is a percentage sign, on brand -->
        <p
          class="font-display font-black leading-none tracking-tighter text-[5rem] sm:text-[7.5rem] mb-4 select-none"
          style="color: var(--text-ink);"
          aria-hidden="true"
        >
          {isNotFound ? (
            <>4<span style="color: var(--accent);">%</span>4</>
          ) : (
            <>5<span style="color: var(--accent);">%</span>0</>
          )}
        </p>

        <h1 class="font-display font-black text-2xl sm:text-4xl tracking-tight mb-3" style="color: var(--text-ink);">
          {copy.heading}
        </h1>
        <p class="text-sm sm:text-base leading-relaxed max-w-xl mx-auto" style="color: var(--text-muted);">
          {copy.text}
        </p>

        <!-- Status meter -->
        <div class="mt-8 max-w-sm mx-auto">
          <div
            class="flex justify-between text-[11px] font-bold uppercase tracking-wider mb-1.5"
            style="color: var(--text-muted);"
          >
            <span>{copy.meterLabel}</span>
            <span>{copy.meterValue}</span>
          </div>
          <div
            class="h-2 rounded-full overflow-hidden border"
            style="background-color: var(--bg-card); border-color: var(--border-hairline);"
            role="img"
            aria-label={`${copy.meterLabel}: ${copy.meterValue}`}
          >
            <div
              class="h-full rounded-full"
              style={isNotFound ? 'width: 0%;' : 'width: 100%; background-color: var(--accent);'}
            >
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={homeRoute}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm transition-transform hover:scale-105 active:scale-95 shadow-md w-full sm:w-auto justify-center"
            style="background-color: var(--accent); color: white;"
          >
            <span>{copy.primaryCta}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <button
            type="button"
            id="error-secondary-btn"
            data-action={copy.secondaryAction}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm border transition-transform hover:scale-105 active:scale-95 w-full sm:w-auto justify-center"
            style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-ink);"
          >
            {
              copy.secondaryAction === 'search' ? (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                </svg>
              ) : (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M20 9A8 8 0 006.3 5.7L4 8m16 8l-2.3 2.3A8 8 0 014 15" />
                </svg>
              )
            }
            <span>{copy.secondaryCta}</span>
          </button>
        </div>

        <p class="mt-6 text-[11px] leading-relaxed" style="color: var(--text-subtle);">
          {copy.hint}
        </p>
      </div>
    </section>

    <!-- Quick links -->
    <nav class="mt-8" aria-label={copy.linksTitle}>
      <h2
        class="font-display font-bold text-xs uppercase tracking-wider mb-3 text-center"
        style="color: var(--text-muted);"
      >
        {copy.linksTitle}
      </h2>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {
          toolLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block h-full px-4 py-3 rounded-2xl border text-xs font-semibold text-center transition-transform hover:scale-105"
                style="background-color: var(--bg-surface); border-color: var(--border-hairline); color: var(--text-body);"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>

<script>
  const secondaryBtn = document.getElementById('error-secondary-btn');
  secondaryBtn?.addEventListener('click', () => {
    if (secondaryBtn.dataset.action === 'search') {
      (window as any).openCommandPalette?.();
    } else {
      window.location.reload();
    }
  });
</script>
